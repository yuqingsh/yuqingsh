<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — do not copy this file directly. Install with:

    CODEX_REMOTE_HOSTS="host1,host2" sh tools/install_launchd.sh

  which renders the placeholders below (__REPO_DIR__, __CODEX_REMOTE_HOSTS__)
  and loads the result into ~/Library/LaunchAgents. Uninstall:

    launchctl unload ~/Library/LaunchAgents/com.github.yuqingsh.tokenusage.plist
    rm ~/Library/LaunchAgents/com.github.yuqingsh.tokenusage.plist

  Runs tools/collect_usage.py every 6 hours (StartInterval seconds),
  plus once at login (RunAtLoad). Logs go to tools/collect.log inside
  the shadow clone.

  NOTE: the job runs in a shadow clone outside ~/Documents because macOS
  TCC blocks launchd-spawned python3 from reading ~/Documents. The main
  working copy receives data/SVG updates via git pull.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.yuqingsh.tokenusage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>tools/collect_usage.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CODEX_REMOTE_HOSTS</key>
        <string>__CODEX_REMOTE_HOSTS__</string>
    </dict>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__REPO_DIR__/tools/collect.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/tools/collect.log</string>
</dict>
</plist>
